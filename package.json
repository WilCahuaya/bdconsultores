{
  "name": "inventario-activos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma B&D Consultores — Inventario, Planillas y módulos de gestión",
  "scripts": {
    "dev": "turbo dev --filter=@inventario/web --filter=@inventario/desktop",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "pnpm --filter @inventario/web dev",
    "dev:desktop": "pnpm --filter @inventario/desktop dev",
    "dev:portal": "pnpm --filter @bd/portal dev",
    "dev:inventarios": "pnpm --filter @bd/inventarios dev",
    "dev:planillas": "pnpm --filter @bd/planillas dev",
    "dev:plataforma": "turbo dev --filter=@bd/portal --filter=@bd/inventarios --filter=@bd/planillas",
    "build:web": "pnpm --filter @inventario/web build",
    "build:desktop": "pnpm --filter @inventario/desktop build",
    "build:portal": "pnpm --filter @bd/portal build",
    "build:inventarios": "pnpm --filter @bd/inventarios build",
    "build:planillas": "pnpm --filter @bd/planillas build",
    "build:desktop:installer": "pnpm --filter @inventario/desktop build:installer",
    "import:catalogo": "node scripts/import-catalogo.mjs",
    "normalize:catalogo-seed": "node scripts/normalize-catalogo-seed.mjs",
    "sync:plataforma-env": "node scripts/sync-plataforma-env.mjs",
    "reset:piloto": "node scripts/reset-piloto-entidades.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  }
}
