# Supabase — obtener en https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública de la app (invitaciones por correo y OAuth callback)
# Producción: https://bdconsultores.vercel.app
# apps/web local: http://localhost:3000
# Plataforma (Portal) local: http://127.0.0.1:3010
NEXT_PUBLIC_SITE_URL=https://bdconsultores.vercel.app
NEXT_PUBLIC_PORTAL_ORIGIN=http://127.0.0.1:3010

# Solo Portal (rewrites Multi Zones). Origins sin path.
# INVENTARIOS_ORIGIN=http://127.0.0.1:3011
# PLANILLAS_ORIGIN=http://127.0.0.1:3012

# Solo servidor (Next.js API routes — nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Desktop (Electron) — mismas variables públicas
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Solo proceso principal Electron (invitaciones) — copiar también a apps/desktop/.env.local
# Nunca exponer al renderer (no usar prefijo VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SITE_URL=https://bdconsultores.vercel.app
